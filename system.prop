#
# system.prop
#

# CNE
persist.vendor.cne.feature=1

# Data modules
persist.data.df.dev_name=rmnet_usb0
persist.vendor.data.mode=concurrent
ro.vendor.use_data_netmgrd=true

# GPS
persist.vendor.overlay.izat.optin=rro

# Graphics
dev.pm.dyn_samplingrate=1

# Multi-Gen LRU
persist.device_config.mglru_native.lru_gen_config=core_and_mm_walk

# QC framework value-adds
ro.vendor.qti.va_aosp.support=1

# RIL
DEVICE_PROVISIONED=1
ril.subscription.types=NV,RUIM
telephony.lteOnCdmaDevice=1

# Time
persist.timed.enable=true

# MistOS
ro.mist.display=1080 x 2400, 120 hz
ro.mist.battery=5000mah
ro.mist.soc=Snapdragon® 695
ro.mist.camera=108MP + 2MP + 2MO
ro.mist.front=16MP
ro.mist.platform=SM6375
ro.mist.screen=6.67' IPS LCD
ro.mist.device.name=OnePlus Nord CE 3 Lite 

